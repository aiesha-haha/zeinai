# ============================================================
#  ZeinAI — переменные окружения (ШАБЛОН)
#  Скопируйте в .env и заполните реальные значения:
#      cp .env.example .env
#  ВАЖНО: файл .env НИКОГДА не коммитится в Git (см. .gitignore).
# ============================================================

# APP
APP_ENV=development
APP_PORT=8000
LOG_LEVEL=info

# Cloudflare Tunnel (для прод-режима docker-compose.yml; локально не нужен)
TUNNEL_TOKEN=

# Google OAuth (веб-логин)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URL=http://localhost:8000/api/v1/auth/google/callback

# DATABASE (PostgreSQL + pgvector)
DB_HOST=db
DB_PORT=5432
DB_USER=zeinai_user
DB_PASSWORD=change_me
DB_NAME=zeinai_db
DB_SSL_MODE=disable

# REDIS
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# RABBITMQ
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=change_me
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_UI_PORT=15672

# JWT (минимум 32 символа; сгенерируйте: openssl rand -hex 32)
JWT_SECRET=change_me_to_a_random_64_char_secret
JWT_EXPIRATION=72h
JWT_REFRESH_EXPIRY=720h

# GEMINI AI
GEMINI_API_KEY=

# OPENAI
OPENAI_API_KEY=

# KIMI K2 (Moonshot AI - Presentation Generation)
KIMI_API_KEY=

# MOBIZON
MOBIZON_API_KEY=

# FCM (Firebase Cloud Messaging) — путь к service-account файлу
FCM_CREDENTIALS_PATH=./firebase-credentials.json

# Web Push (VAPID)
WEBPUSH_VAPID_PUBLIC_KEY=
WEBPUSH_VAPID_PRIVATE_KEY=
WEBPUSH_SUBSCRIBER=mailto:you@example.com

# SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=ZeinAI <no-reply@example.com>
